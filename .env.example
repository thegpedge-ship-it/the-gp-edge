# Clerk Authentication Configuration
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Clerk Sign In / Sign Up Redirection Routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon Postgres (Prisma)
# DATABASE_URL = Neon Pooled connection string (host contains "-pooler" / pgbouncer=true) — used at runtime for serverless connection pooling.
# DIRECT_URL   = Neon Direct connection string (no "-pooler") — used for database migrations, `prisma db push`, and schema introspection.
# Both strings are available in the Neon dashboard under "Connection Details". Ensure ?sslmode=require is preserved.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require

# Cloudflare R2 Configuration
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_BUCKET_NAME=your_cloudflare_bucket_name_here
R2_ACCESS_KEY_ID=your_cloudflare_access_key_id_here
R2_SECRET_ACCESS_KEY=your_cloudflare_secret_access_key_here
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-yourbucketid.r2.dev

# ─── Stripe Payments ──────────────────────────────────────────────────────────
# Get these from your Stripe Dashboard → Developers → API keys & Webhooks
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Stripe Price IDs — create these in your Stripe Dashboard → Products
# Registrar plans are ONE-TIME PAYMENTS (mode: 'payment')
STRIPE_PRICE_REGISTRAR_6MONTH=price_registrar_6month_id_here
STRIPE_PRICE_REGISTRAR_12MONTH=price_registrar_12month_id_here

# Fellowship plans are RECURRING SUBSCRIPTIONS (mode: 'subscription')
STRIPE_PRICE_FELLOWSHIP_MONTHLY=price_fellowship_monthly_id_here
STRIPE_PRICE_FELLOWSHIP_YEARLY=price_fellowship_yearly_id_here

# Post-Registrar Upgrade is a RECURRING SUBSCRIPTION (mode: 'subscription')
STRIPE_PRICE_POST_REGISTRAR_MONTHLY=price_post_registrar_monthly_id_here
